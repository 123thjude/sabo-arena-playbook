{
  "name": "@sabo-arena/rag-chatbot",
  "version": "1.0.0",
  "description": "RAG-powered chatbot for SABO Arena",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ingest": "node -e \"require('./rag-system').ingestDocs().then(r => console.log('Done:', r.length, 'docs'))\"",
    "sync": "node sync-docs.js",
    "sync:ingest": "node sync-docs.js && node -e \"require('./rag-system').ingestDocs().then(r => console.log('Done:', r.length, 'docs'))\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
